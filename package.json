{
  "name": "iota-board-game",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh": "node scripts/build-gh-pages.js",
    "preview": "vite preview",
    "deploy": "npm run build:gh && gh-pages -d dist",
    "preview:gh": "node scripts/serve-gh-pages.js",
    "test": "vitest --environment jsdom --run",
    "test:watch": "vitest --environment jsdom --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:gh": "GITHUB_PAGES=true storybook build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky install",
    "pre-push": "npm run lint && npm run build && npm run build:gh && npm test && npm run build-storybook && npm run build-storybook:gh"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx --no -- lint-staged"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "classnames": "^2.5.1",
    "colorjs.io": "^0.5.0",
    "date-fns": "^3.0.0",
    "peerjs": "^1.5.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.0",
    "@storybook/react": "^7.6.0",
    "@storybook/react-vite": "^7.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gh-pages": "^6.1.0",
    "husky": "^9.1.7",
    "jsdom": "^21.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^2.8.8",
    "storybook": "^7.6.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
